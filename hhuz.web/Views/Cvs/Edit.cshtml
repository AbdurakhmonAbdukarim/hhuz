@model hhuz.Dto.CvEditViewModel

@{
    ViewData["Title"] = $"Edit CV - {Model.PositionTitle}";
}

<div class="container py-4">
    <h1>@Model.PositionTitle</h1>
    <p class="text-muted">Edit your CV for this position</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    <form method="post" asp-action="Save" asp-route-id="@Model.CvId">
        @Html.AntiForgeryToken()

        <input type="hidden" name="CvVersion" value="@Model.CvVersion" />

        <div class="row">
            <div class="col-md-8">
                @foreach (var attr in Model.PositionAttributes)
                {
                    <div class="mb-4">
                        <label class="form-label fw-bold">
                            @attr.Name
                        </label>

                        @switch ((hhuz.Models.AttributeDataType)attr.DataType)
                        {
                            case hhuz.Models.AttributeDataType.STRING:
                                <input type="text" 
                                       name="AttributeValues[@attr.AttributeId]" 
                                       class="form-control" 
                                       value="@attr.CurrentValue" />
                                break;

                            case hhuz.Models.AttributeDataType.TEXT:
                                <textarea name="AttributeValues[@attr.AttributeId]" 
                                          class="form-control" 
                                          rows="4">@attr.CurrentValue</textarea>
                                break;

                            case hhuz.Models.AttributeDataType.NUMERIC:
                                <input type="number" 
                                       name="AttributeValues[@attr.AttributeId]" 
                                       class="form-control" 
                                       value="@attr.CurrentValue" />
                                break;

                            case hhuz.Models.AttributeDataType.DATE:
                                <input type="date" 
                                       name="AttributeValues[@attr.AttributeId]" 
                                       class="form-control" 
                                       value="@attr.CurrentValue" />
                                break;

                            case hhuz.Models.AttributeDataType.BOOLEAN:
                                <div class="form-check">
                                    <input type="checkbox"
                                           name="AttributeValues[@attr.AttributeId]"
                                           class="form-check-input"
                                           value="true"
                                           checked="@(attr.CurrentValue == "true")" />
                                    <input type="hidden" name="AttributeValues[@attr.AttributeId]" value="false" />
                                    <label class="form-check-label">Yes</label>
                                </div>
                                break;

                            case hhuz.Models.AttributeDataType.DROPDOWN:
                                <select name="AttributeOptions[@attr.AttributeId]" class="form-select">
                                    <option value="">-- Select --</option>
                                    @foreach (var opt in attr.Options)
                                    {
                                        if (attr.CurrentOptionId == opt.Id)
                                        {
                                            <option value="@opt.Id" selected>@opt.Value</option>
                                        }
                                        else
                                        {
                                            <option value="@opt.Id">@opt.Value</option>
                                        }
                                    }
                                </select>
                                break;
                        }
                    </div>
                }

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Save Draft</button>
                    <a href="@Url.Action("Details", new { id = Model.CvId })" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </div>
        </div>
    </form>
</div>