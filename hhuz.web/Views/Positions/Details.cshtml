@model hhuz.Dto.PositionViewDto

@{
    ViewData["Title"] = Model.Position.Title;
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-body">
                    <h1 class="mb-2">@Model.Position.Title</h1>
                    <p class="text-muted mb-3">@Model.Position.ShortDescription</p>

                    @* Tabs *@
                    <ul class="nav nav-tabs mb-4" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="overview-tab" data-bs-toggle="tab"
                                    data-bs-target="#overview" type="button" role="tab">
                                Overview
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="discussions-tab" data-bs-toggle="tab"
                                    data-bs-target="#discussions" type="button" role="tab">
                                Discussions (@Model.Discussions.Count)
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content">
                        @* Overview Tab *@
                        <div class="tab-pane fade show active" id="overview" role="tabpanel">
                            @if (Model.Position.PositionAttributes != null && Model.Position.PositionAttributes.Any())
                            {
                                <h5>Required Information</h5>
                                <ul class="list-group mb-4">
                                    @foreach (var attr in Model.Position.PositionAttributes.OrderBy(pa => pa.SortOrder))
                                    {
                                        <li class="list-group-item">
                                            <strong>@attr.Name</strong>
                                            <br />
                                            <small class="text-muted">@attr.Description</small>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>

                        @* Discussions Tab *@
                        <div class="tab-pane fade" id="discussions" role="tabpanel">
                            <partial name="_Discussions" model="Model.Discussions" />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card sticky-top" style="top: 20px;">
                <div class="card-body">
                    <p class="text-muted small mb-2">
                        Posted: @Model.Position.CreatedAt.ToString("dd MMM yyyy")
                    </p>

                    @if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Auth" asp-action="Login" class="btn btn-primary w-100 mb-2">
                            Login to Create CV
                        </a>
                    }
                    else if (User.IsInRole("ROLE_CANDIDATE"))
                    {
                        <form method="post" asp-controller="Cvs" asp-action="Create"
                              asp-route-positionId="@Model.Position.Id">
                            <button type="submit" class="btn btn-primary w-100 mb-2">
                                Create CV for this Position
                            </button>
                        </form>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const positionId = '@Model.Position.Id';
        const userId = '@(User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "")';
    </script>
}