<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - HHUZ</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <!-- Your CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">

            <a class="navbar-brand"
               asp-controller="Home"
               asp-action="Index">
                HHUZ
            </a>

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">

                <ul class="navbar-nav me-auto">

                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Positions"
                           asp-action="Index">
                            Positions
                        </a>
                    </li>

                    @if (User.IsInRole("ROLE_RECRUITER") || User.IsInRole("ROLE_ADMIN"))
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Attribute"
                               asp-action="Index">
                                Attributes
                            </a>
                        </li>
                    }

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Projects"
                               asp-action="Index">
                                Projects
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Profile"
                               asp-action="Index">
                                Profile
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Cvs"
                               asp-action="Index">
                                CVs
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Profile"
                               asp-action="Index">
                                Profile
                            </a>
                        </li>
                    }

                </ul>

                <div class="d-flex align-items-center">

                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="text-light me-3">
                            @User.Identity.Name
                        </span>

                        <form asp-controller="Auth"
                              asp-action="Logout"
                              method="post">

                            <button type="submit"
                                    class="btn btn-outline-light btn-sm">
                                Logout
                            </button>

                        </form>
                    }
                    else
                    {
                        <a asp-controller="Auth"
                           asp-action="Login"
                           class="btn btn-outline-light btn-sm me-2">
                            Login
                        </a>

                        <a asp-controller="Auth"
                           asp-action="Register"
                           class="btn btn-light btn-sm">
                            Register
                        </a>
                    }

                </div>

            </div>
        </div>
    </nav>


    <main class="container py-4">
        @RenderBody()
    </main>


    <footer class="border-top text-muted py-3">
        <div class="container text-center">
            HHUZ © 2026
        </div>
    </footer>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>