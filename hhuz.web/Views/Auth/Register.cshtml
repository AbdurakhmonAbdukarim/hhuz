@model hhuz.Dto.LoginDto

<form asp-controller="Auth" asp-action="Register" method="post">
    <div class="mb-3">
        <label>Username</label>
        <input asp-for="username" class="form-control" placeholder="Username" required />
    </div>

    <div class="mb-3">
        <label>Email</label>
        <input asp-for="email" type="email" class="form-control" placeholder="Email" required />
    </div>

    <div class="mb-3">
        <label>Parol</label>
        <input asp-for="password" type="password" class="form-control" placeholder="Parol" required />
    </div>

    <button type="submit" class="btn btn-primary">Ro'yxatdan o'tish</button>
</form>

@if (ViewBag.Error != null)
{
    <p style="color:red" class="mt-2">@ViewBag.Error</p>
}