@{
    ViewData["Title"] = "Home";

    var positions = ViewBag.Positions as List<hhuz.Models.Positions>;
    var totalPositions = ViewBag.TotalPositions ?? 0;
    var totalUsers = ViewBag.TotalUsers ?? 0;
    var newCvsLast24Hours = ViewBag.NewCvsLast24Hours ?? 0;
}

<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">
            Welcome to HHUZ
        </h1>

        <p class="lead text-muted">
            Find opportunities, build your CV, and connect with recruiters.
        </p>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <a asp-controller="Auth"
               asp-action="Register"
               class="btn btn-primary btn-lg me-2">
                Get Started
            </a>

            <a asp-controller="Auth"
               asp-action="Login"
               class="btn btn-outline-secondary btn-lg">
                Login
            </a>
        }
        else
        {
            <a asp-controller="Positions"
               asp-action="Index"
               class="btn btn-primary btn-lg">
                Browse Positions
            </a>
        }
    </div>


    <!-- Statistics -->

    <div class="row g-3 mb-5">

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3>@totalPositions</h3>
                    <p class="text-muted mb-0">
                        Total Positions
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3>@totalUsers</h3>
                    <p class="text-muted mb-0">
                        Registered Users
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card text-center shadow-sm">
                <div class="card-body">
                    <h3>@newCvsLast24Hours</h3>
                    <p class="text-muted mb-0">
                        New CVs (24h)
                    </p>
                </div>
            </div>
        </div>

    </div>


    <!-- Latest Positions -->

    <div class="mb-4">
        <h2>Latest Positions</h2>
    </div>

    @if (positions != null && positions.Any())
    {
        <div class="table-responsive">

            <table class="table table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Title</th>
                        <th>Description</th>
                        <th>Max Projects</th>
                        <th>Created</th>
                    </tr>
                </thead>

                <tbody>

                @foreach (var position in positions)
                {
                    <tr>
                        <td>
                            <strong>@position.Title</strong>
                        </td>

                        <td>
                            @position.ShortDescription
                        </td>

                        <td>
                            @position.MaxProjects
                        </td>

                        <td>
                            @position.CreatedAt.ToLocalTime()
                        </td>
                    </tr>
                }

                </tbody>

            </table>

        </div>
    }
    else
    {
        <div class="alert alert-info">
            No positions available.
        </div>
    }

</div>