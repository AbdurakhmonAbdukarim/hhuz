@model List<hhuz.Models.Attributes>

@{
    ViewData["Title"] = "Attributes Library";
    var categories = ViewBag.Categories as List<hhuz.Models.Categories>;
    var selectedCategory = ViewBag.SelectedCategory as string;
    var search = ViewBag.Search as string;
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h2 class="mb-0">Attribute Library</h2>
            <p class="text-muted mb-0 mt-1">Manage reusable attributes</p>
        </div>
        <a asp-controller="Attribute" asp-action="Create" class="btn btn-primary">
            + Create Attribute
        </a>
    </div>

    {{-- Filters --}}
    <div class="card mb-3">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-end">
                <div class="col-md-4">
                    <label class="form-label small">Search</label>
                    <input type="text" name="search" class="form-control form-control-sm"
                           placeholder="Attribute name..."
                           value="@search" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">Category</label>
                    <select name="categoryId" class="form-select form-select-sm">
                        <option value="">All Categories</option>
                        @foreach (var cat in categories ?? new List<hhuz.Models.Categories>())
                        {
                            <option value="@cat.Id" selected="@(cat.Id == selectedCategory)">
                                @cat.Name
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                        Filter
                    </button>
                </div>
                <div class="col-md-2">
                    <a asp-action="Index" class="btn btn-sm btn-link text-muted w-100">
                        Clear
                    </a>
                </div>
            </form>
        </div>
    </div>

    {{-- Toolbar --}}
    <div id="selection-toolbar"
         class="d-none mb-3 p-2 border rounded bg-light d-flex align-items-center gap-3">
        <span class="text-muted small">
            <span id="selected-count">0</span> selected
        </span>
        <button id="btn-edit"
                class="btn btn-sm btn-outline-secondary"
                disabled
                onclick="editSelected()">
            Edit
        </button>
        <form id="delete-form" method="post" style="display:inline">
            @Html.AntiForgeryToken()
            <input type="hidden" name="ids" />
            <button type="button"
                    class="btn btn-sm btn-outline-danger"
                    id="btn-delete"
                    disabled
                    onclick="deleteSelected()">
                Delete
            </button>
        </form>
        <button class="btn btn-sm btn-link text-muted ms-auto"
                onclick="clearSelection()">
            Clear
        </button>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle" id="attributes-table">
                <thead class="table-dark">
                <tr>
                    <th style="width: 40px">
                        <input type="checkbox" id="select-all"
                               class="form-check-input"
                               onchange="toggleAll(this)" />
                    </th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Type</th>
                    <th>Description</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var attr in Model)
                {
                    <tr class="attr-row" data-id="@attr.Id"
                        onclick="rowClick(event, this)" style="cursor: pointer">
                        <td onclick="event.stopPropagation()">
                            <input type="checkbox" class="form-check-input row-checkbox"
                                   value="@attr.Id" onchange="onCheckboxChange()" />
                        </td>
                        <td><strong>@attr.Name</strong></td>
                        <td>
                            <span class="badge bg-info">@attr.Category?.Name</span>
                        </td>
                        <td>
                            <small class="text-muted">@GetDataTypeName(attr.DataType)</small>
                        </td>
                        <td class="text-muted small">@attr.Description</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">No attributes found.</div>
    }

</div>

@section Scripts {
<script>
    function getChecked() {
        return [...document.querySelectorAll('.row-checkbox:checked')];
    }

    function onCheckboxChange() {
        const checked = getChecked();
        const count = checked.length;
        const toolbar = document.getElementById('selection-toolbar');
        const btnEdit = document.getElementById('btn-edit');
        const btnDelete = document.getElementById('btn-delete');

        if (count > 0) {
            toolbar.classList.remove('d-none');
            toolbar.classList.add('d-flex');
        } else {
            toolbar.classList.add('d-none');
            toolbar.classList.remove('d-flex');
        }

        document.getElementById('selected-count').textContent = count;
        btnEdit.disabled = count !== 1;
        btnDelete.disabled = count === 0;
    }

    function toggleAll(master) {
        document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = master.checked);
        onCheckboxChange();
    }

    function rowClick(event, row) {
        if (event.target.type === 'checkbox') return;
        const cb = row.querySelector('.row-checkbox');
        if (cb) {
            cb.checked = !cb.checked;
            onCheckboxChange();
        }
    }

    function clearSelection() {
        document.querySelectorAll('.row-checkbox').forEach(cb => cb.checked = false);
        document.getElementById('select-all').checked = false;
        onCheckboxChange();
    }

    function editSelected() {
        const checked = getChecked();
        if (checked.length !== 1) return;
        window.location.href = `/Attributes/Edit/${checked[0].value}`;
    }

    function deleteSelected() {
        const checked = getChecked();
        if (checked.length === 0) return;

        const ids = checked.map(cb => cb.value);
        const msg = ids.length === 1 ? 'Delete this attribute?' : `Delete ${ids.length} attributes?`;

        if (!confirm(msg)) return;

        const form = document.getElementById('delete-form');
        form.querySelectorAll('input[name="ids"]').forEach(el => el.remove());

        ids.forEach(id => {
            const input = document.createElement('input');
            input.type = 'hidden';
            input.name = 'ids';
            input.value = id;
            form.appendChild(input);
        });

        form.action = '/Attributes/DeleteBulk';
        form.submit();
    }
</script>
}

@functions {
    string GetDataTypeName(hhuz.Models.AttributeDataType type)
    {
        return type switch
        {
            hhuz.Models.AttributeDataType.STRING => "String",
            hhuz.Models.AttributeDataType.TEXT => "Text (Markdown)",
            hhuz.Models.AttributeDataType.IMAGE => "Image",
            hhuz.Models.AttributeDataType.NUMERIC => "Numeric",
            hhuz.Models.AttributeDataType.DATE => "Date",
            hhuz.Models.AttributeDataType.PERIOD => "Period",
            hhuz.Models.AttributeDataType.BOOLEAN => "Boolean",
            hhuz.Models.AttributeDataType.DROPDOWN => "Dropdown",
            _ => "Unknown"
        };
    }
}